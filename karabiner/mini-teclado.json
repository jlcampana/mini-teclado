{
    "title": "Mini teclado CH57x (1189:8890)",
    "rules": [
        {
            "description": "Mini teclado: Ctrl → Cmd e ImprPant → Cmd+Shift+5",
            "manipulators": [
                {
                    "type": "basic",
                    "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 4489, "product_id": 34960 }] }],
                    "from": { "key_code": "left_control", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "left_command" }]
                },
                {
                    "type": "basic",
                    "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 4489, "product_id": 34960 }] }],
                    "from": { "key_code": "print_screen", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "5", "modifiers": ["left_command", "left_shift"] }]
                }
            ]
        }
    ]
}
