{
    "title": "Mini teclado CH57x (1189:8890)",
    "rules": [
        {
            "description": "Mini teclado: Ctrl+C/Ctrl+V → Cmd+C/Cmd+V e ImprPant → Cmd+Shift+5",
            "manipulators": [
